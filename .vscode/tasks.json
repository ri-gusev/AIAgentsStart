{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure OpenAI Web Chat (CMake)",
      "type": "process",
      "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
      "args": ["--preset", "mingw-debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build OpenAI Web Chat (CMake)",
      "type": "process",
      "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
      "args": ["--build", "--preset", "mingw-debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Configure OpenAI Web Chat (CMake)",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
